rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Cabinets
    match /cabinets/{cabinetId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.adminUid;
    }

    // Dossiers
    match /dossiers/{dossierId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.authorizedUsers;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.authorizedUsers;
    }

    // Documents
    match /documents/{documentId} {
      allow read, write: if request.auth != null;
    }

    // Activation Codes
    match /activationCodes/{codeId} {
      // Anyone authenticated can read (to validate codes)
      allow read: if request.auth != null;
      // Only admins can create (checked at app level)
      allow create: if request.auth != null;
      // Anyone can update (to mark as used) — app logic validates
      allow update: if request.auth != null;
    }

    // Internal Messages
    match /internal_messages/{messageId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow update: if request.auth != null && request.auth.uid == resource.data.receiverId;
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Payments (legacy, read-only)
    match /payments/{paymentId} {
      allow read: if request.auth != null;
    }

    // Ping test
    match /_ping/{docId} {
      allow read: if request.auth != null;
    }
  }
}
